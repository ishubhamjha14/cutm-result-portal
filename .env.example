# ==========================================
# CENTURION UNIVERSITY OF TECHNOLOGY AND MANAGEMENT (CUTM)
# RESULT PORTAL ENVIRONMENT CONFIGURATION
# ==========================================

# Backend API Settings
PROJECT_NAME="CUTM RESULT PORTAL API"
VERSION="1.0.0"
API_V1_STR="/api"

# Database
DATABASE_URL="sqlite:///./cutm_results.db"
# Production example:
# DATABASE_URL="postgresql://username:password@host/database"

# JWT Authentication
JWT_SECRET="replace-with-your-own-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"

# Initial Admin Seed
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="change-this-password"
ADMIN_DEFAULT_NAME="CUTM Administrator"
