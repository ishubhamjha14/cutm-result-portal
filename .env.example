# Backend API Settings
PROJECT_NAME="CUTM RESULT PORTAL API"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Connection (SQLite for local zero-config, PostgreSQL for production)
# Local SQLite default:
DATABASE_URL="sqlite:///./cutm_results.db"
# PostgreSQL Cloud Production (Neon / Supabase / Render / Railway):
# DATABASE_URL="postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/cutm_results?sslmode=require"

# JWT Authentication
JWT_SECRET="cutm_secret_key_change_in_production_2026_super_secure_key_exam_portal"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000"

# Initial Super Admin Seed (Provisioned on first database startup if no admin exists)
ADMIN_DEFAULT_EMAIL="admin@cutm.ac.in"
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="Admin@CUTM2026"
ADMIN_DEFAULT_NAME="Prof. Controller of Examinations (CUTM)"
